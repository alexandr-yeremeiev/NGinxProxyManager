#!/usr/bin/env bash
# Nginx Proxy Manager one-shot installer for Ubuntu 24.04
# Usage: ./NPM-Autoinstaller

set -euo pipefail

NPM_DIR="/opt/nginx-proxy-manager"

echo "[+] Скрипт запущен. Очищаем старые ошибки репозиториев..."
rm -f /etc/apt/sources.list.d/docker.list

echo "[+] Обновляем системные пакеты..."
apt-get update -y
DEBIAN_FRONTEND=noninteractive apt-get install -y ca-certificates curl gnupg lsb-release lsof ufw openssl

# Проверяем, установлен ли Docker. Если нет — ставим его стандартным пакетом Ubuntu
if ! command -v docker >/dev/null 2>&1; then
  echo "[+] Устанавливаем Docker и Docker Compose..."
  DEBIAN_FRONTEND=noninteractive apt-get install -y docker.io docker-compose-v2
  systemctl enable docker
  systemctl start docker
else
  echo "[=] Docker уже установлен в системе."
fi

echo "[+] Создаем директории для Nginx Proxy Manager..."
mkdir -p "${NPM_DIR}/data" "${NPM_DIR}/letsencrypt" "${NPM_DIR}/data/mysql"

echo "[+] Создаем конфигурационный файл docker-compose.yml..."
cat > "${NPM_DIR}/docker-compose.yml" << 'EOF'
services:
  app:
    image: "jc21/nginx-proxy-manager:latest"
    restart: unless-stopped
    ports:
      - "80:80"
      - "81:81"
      - "443:443"
    environment:
      DB_MYSQL_HOST: "db"
      DB_MYSQL_PORT: 3306
      DB_MYSQL_USER: "npm"
      DB_MYSQL_PASSWORD: "npm_password_123"
      DB_MYSQL_NAME: "npm_db"
    volumes:
      - ./data:/data
      - ./letsencrypt:/etc/letsencrypt
    depends_on:
      - db

  db:
    image: "jc21/mariadb-aria:latest"
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: "root_password_123"
      MYSQL_DATABASE: "npm_db"
      MYSQL_USER: "npm"
      MYSQL_PASSWORD: "npm_password_123"
    volumes:
      - ./data/mysql:/var/lib/mysql
EOF

echo "[+] Настраиваем порты в брандмауэре UFW..."
if ufw status | grep -q "Status: active"; then
  ufw allow 80/tcp || true
  ufw allow 81/tcp || true
  ufw allow 443/tcp || true
fi

echo "[+] Запускаем контейнеры Nginx Proxy Manager через Docker Compose..."
cd "${NPM_DIR}"
docker compose up -d

echo "=============================================="
echo "      Установка успешно завершена!"
echo "      Панель управления: http://YOUR_SERVER_IP:81"
echo "=============================================="
